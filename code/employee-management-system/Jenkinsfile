pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Backend checks') {
      steps {
        dir('backend') {
          sh 'npm install --package-lock-only --ignore-scripts'
          sh 'npm ci --ignore-scripts'
          sh 'npm run check'
        }
      }
    }
    stage('Frontend build') {
      steps {
        dir('frontend') {
          sh 'npm install --package-lock-only --ignore-scripts'
          sh 'npm ci --ignore-scripts'
          sh 'npm run build'
        }
      }
    }
    stage('Container build') { steps { sh 'docker compose -f compose.yaml build' } }
  }
  post { always { echo 'EMS CI checks finished. Add integration tests and security scanning before production.' } }
}
