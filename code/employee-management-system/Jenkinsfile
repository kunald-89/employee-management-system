pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Backend checks') {
      steps {
        dir('code/employee-management-system/backend') {
          sh 'npm install --ignore-scripts'
          sh 'npm run check'
        }
      }
    }
    stage('Frontend build') {
      steps {
        dir('code/employee-management-system/frontend') {
          sh 'npm install --ignore-scripts'
          sh 'npm run build'
        }
      }
    }
    stage('Container build') {
      steps {
        dir('code/employee-management-system') {
          sh 'docker compose -f compose.yaml build'
        }
      }
    }
    stage('API integration tests') {
      steps {
        dir('code/employee-management-system') {
          sh 'docker compose -f compose.yaml up -d'
          sh 'docker compose -f compose.yaml exec -T -e API_URL=http://backend:5000 backend npm run test:api'
        }
      }
    }
  }
  post {
    always {
      dir('code/employee-management-system') {
        sh(script: 'docker compose -f compose.yaml down -v', returnStatus: true)
      }
      echo 'EMS CI checks and API integration test stage finished.'
    }
  }
}
